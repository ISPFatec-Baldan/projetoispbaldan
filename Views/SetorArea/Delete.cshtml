@model ProjetoISP.Baldan.Models.Setores.SetorArea

@{
    ViewData["Title"] = "Excluir setor";
}

<h1>Excluir setor</h1>

<h5 class="text-danger">Tem certeza de que deseja excluir este setor?</h5>

<dl class="row">
    <dt class="col-sm-2">Nome</dt>
    <dd class="col-sm-10">@Model.Nome</dd>

    <dt class="col-sm-2">Unidade</dt>
    <dd class="col-sm-10">@ViewBag.NomeUnidade</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Excluir</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
