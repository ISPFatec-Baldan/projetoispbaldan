@{
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string Ativo(params string[] nomes) =>
        nomes.Contains(controlador, StringComparer.OrdinalIgnoreCase) ? "ativo" : "";
    var cadastrosAbertos = new[] { "Unidades", "SetorArea", "Usuario", "Categoria" }
        .Contains(controlador, StringComparer.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Baldan ISP</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/isp.css" asp-append-version="true" />
</head>
<body class="isp">
    <div class="isp-moldura">

        @* ===== Menu lateral (escuro, com nomes; o botão recolhe para só ícones) ===== *@
        <aside class="isp-lateral" aria-label="Menu principal">
            <div class="isp-lateral-topo">
                <span class="isp-lateral-marca">Menu</span>
                <button type="button" id="botaoMenu" class="botao-menu" aria-label="Recolher menu" aria-expanded="true">
                    <svg viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" aria-hidden="true">
                        <path d="M5 9h26M5 18h26M5 27h26" />
                    </svg>
                </button>
            </div>

            <a asp-controller="Home" asp-action="Index" class="item-menu @Ativo("Home")" title="Painel">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 11.5 12 4l9 7.5" />
                    <path d="M5 10v10h5v-6h4v6h5V10" />
                </svg>
                <span class="rotulo">Painel</span>
            </a>

            <a asp-controller="InspecoesISP" asp-action="Index" class="item-menu @Ativo("InspecoesISP", "ResultadoInspecao")" title="Inspeções">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M4 20l1-5L16 4l4 4L9 19z" />
                    <path d="M14 6l4 4" />
                </svg>
                <span class="rotulo">Inspeções</span>
            </a>

            <a asp-controller="ModeloChecklist" asp-action="Index" class="item-menu @Ativo("ModeloChecklist")" title="Checklists">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="5" y="3" width="14" height="18" rx="2" />
                    <path d="M9 8h6M9 12h6" />
                    <path d="m9 17 2 2 4-4" />
                </svg>
                <span class="rotulo">Checklists</span>
            </a>

            <a asp-controller="Perguntas" asp-action="Index" class="item-menu @Ativo("Perguntas", "ItemChecklist")" title="Perguntas">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.7.4-1 .9-1 1.7" />
                    <path d="M12 17h.01" />
                </svg>
                <span class="rotulo">Perguntas</span>
            </a>

            <a asp-controller="PlanoAcao5W2H" asp-action="Index" class="item-menu @Ativo("PlanoAcao5W2H", "HistoricoPrazo5W2H")" title="Planos de ação">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" />
                    <circle cx="12" cy="12" r="5" />
                    <circle cx="12" cy="12" r="1.5" fill="currentColor" />
                </svg>
                <span class="rotulo">Planos de ação</span>
            </a>

            <details open="@cadastrosAbertos">
                <summary title="Cadastros">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <ellipse cx="12" cy="6" rx="8" ry="3" />
                        <path d="M4 6v6c0 1.7 3.6 3 8 3s8-1.3 8-3V6" />
                        <path d="M4 12v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6" />
                    </svg>
                    <span class="rotulo">Cadastros</span>
                    <svg class="seta" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                </summary>
                <div class="submenu">
                    <a asp-controller="Unidades" asp-action="Index" class="item-menu @Ativo("Unidades")">Unidades</a>
                    <a asp-controller="SetorArea" asp-action="Index" class="item-menu @Ativo("SetorArea")">Setores</a>
                    <a asp-controller="Usuario" asp-action="Index" class="item-menu @Ativo("Usuario")">Usuários</a>
                    <a asp-controller="Categoria" asp-action="Index" class="item-menu @Ativo("Categoria")">Categorias</a>
                </div>
            </details>
        </aside>

        <div class="isp-principal">

            @* ===== Cabeçalho ===== *@
            <header class="isp-cabecalho">
                @* Troque este bloco pela imagem do logo quando tiver o arquivo:
                   <img src="~/img/logo-baldan-isp.png" alt="Baldan ISP" height="40" /> *@
                <a asp-controller="Home" asp-action="Index" class="isp-logo" aria-label="Baldan ISP">
                    <svg viewBox="0 0 40 30" width="34" height="26" fill="none" stroke="#E30613" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M3 4l11 11L3 26" />
                        <path d="M20 4l11 11-11 11" />
                    </svg>
                    <span class="isp-logo-nome">BALDAN</span>
                    <span class="isp-logo-sep">|</span>
                    <span class="isp-logo-isp">ISP</span>
                </a>

                @* Nome de quem está logado + botão para sair (ícone do usuário) *@
                <div class="isp-usuario-area">
                    <span class="isp-usuario-nome">@User.Identity?.Name</span>
                    <form asp-controller="Conta" asp-action="Sair" method="post">
                        <button type="submit" class="isp-usuario" title="Sair" aria-label="Sair">
                            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true">
                                <circle cx="24" cy="24" r="21" />
                                <circle cx="24" cy="18" r="7" />
                                <path d="M9 38c2-8 8-11 15-11s13 3 15 11" />
                            </svg>
                        </button>
                    </form>
                </div>
            </header>

            <main role="main" class="isp-conteudo">
                @RenderBody()
            </main>

            <footer class="isp-rodape">
                Baldan &copy; @DateTime.Now.Year. Todos os direitos reservados.
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/isp.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
