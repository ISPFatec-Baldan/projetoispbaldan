@model IEnumerable<ProjetoISP.Baldan.Models.Setores.Unidade>

@{
    ViewData["Title"] = "Unidades";
}

<h1>Unidades</h1>

<partial name="_Mensagens" />

<p>
    <a asp-action="Create" class="btn btn-primary">Nova unidade</a>
</p>

@if (!Model.Any())
{
    <p class="text-muted">Nenhuma unidade cadastrada.</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Cidade</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Nome</td>
                    <td>@item.Cidade</td>
                    <td>@item.Estado</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Detalhes</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
