@model ProjetoISP.Baldan.Models.DashboardViewModel

@{
    ViewData["Title"] = "Painel";
    Layout = "_LayoutISP";   // usa a moldura do Figma só nesta tela (as demais continuam com o layout atual)
}

@* ===== Indicadores ===== *@
<section class="kpi-grade" aria-label="Indicadores">
    <article class="kpi-cartao">
        @* Meta de 90% para ficar verde: ajuste conforme a regra da Baldan *@
        <div class="kpi-valor @(Model.TaxaConformidadeSemana >= 90 ? "texto-ok" : "texto-ruim")">@($"{Model.TaxaConformidadeSemana:0}%")</div>
        <div class="kpi-rotulo">Taxa de Conformidade<br />da Semana</div>
    </article>

    <article class="kpi-cartao kpi-destaque">
        <div class="kpi-valor">@Model.PlanosPendentesAnalise</div>
        <div class="kpi-rotulo">Planos de Ação<br />Pendentes de Análise</div>
    </article>

    <article class="kpi-cartao">
        <div class="kpi-valor texto-ruim">@Model.NaoConformidadesReincidentes</div>
        <div class="kpi-rotulo">Não Conformidades<br />Reincidentes</div>
    </article>

    <article class="kpi-cartao">
        <div class="kpi-valor">@Model.TotalInspecoesMes</div>
        <div class="kpi-rotulo">Total de Inspeções<br />Realizadas no Mês</div>
    </article>
</section>

<section class="painel-grade">

    @* ===== Checklists por setor ===== *@
    <div class="painel-setores">
        <h2 class="painel-titulo-pequeno">
            Checklist realizados por setor da atual semana (@Model.ChecklistsRealizadosSemana):
        </h2>
        <ul class="lista-setores">
            @foreach (var setor in Model.SetoresSemana)
            {
                <li>
                    <span>@setor.Nome</span>
                    <span class="bolinha @(setor.Ok ? "ok" : "ruim")" role="img"
                          aria-label="@(setor.Ok ? "sem pendência" : "com pendência")"></span>
                </li>
            }
        </ul>
    </div>

    @* ===== Filtros de recorrência (visuais; ainda sem ação) ===== *@
    <div class="painel-filtros">
        <label for="filtroPeriodo" class="painel-titulo-pequeno">Recorrências registradas por período:</label>
        <input type="date" id="filtroPeriodo" class="form-control form-control-sm filtro-campo" />

        <label for="filtroSetor" class="painel-titulo-pequeno">Recorrências registradas por setor:</label>
        <select id="filtroSetor" class="form-select form-select-sm filtro-campo">
            <option value="">Selecione</option>
            @foreach (var setor in Model.SetoresSemana)
            {
                <option value="@setor.Nome">@setor.Nome</option>
            }
        </select>
    </div>

    @* ===== Gráfico de pizza ===== *@
    <div class="painel-grafico">
        <h2 class="painel-titulo">Status de Ações ISP - Comparativo</h2>
        <p class="painel-subtitulo">@Model.PeriodoComparativo</p>
        <div class="grafico-area">
            <canvas id="graficoStatusAcoes" role="img" aria-label="Gráfico de pizza com o status das ações ISP"></canvas>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        window.dadosDashboard = @Json.Serialize(new
        {
                rotulos = Model.StatusAcoes.Select(s => s.Status),
                valores = Model.StatusAcoes.Select(s => s.Quantidade),
                cores = Model.StatusAcoes.Select(s => s.Cor)
        });
</script>
<script src="~/js/dashboard.js" asp-append-version="true"></script>
}
